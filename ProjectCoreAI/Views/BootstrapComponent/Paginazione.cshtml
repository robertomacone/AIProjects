@model IEnumerable<ProjectCoreAI.Models.ViewModels.ProductTableRowViewModel>
@{
    ViewData["Title"] = "DataTable con paginazione";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.bootstrap5.css" />
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-3">Esempio DataTable Bootstrap</h1>
        <p class="text-muted">Tabella con paginazione abilitata e 20 record per pagina.</p>

        <table id="productsTable" class="table table-striped table-bordered align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Prezzo</th>
                    <th>Data creazione</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.bootstrap5.js"></script>
    <script>
        new DataTable('#productsTable', {
            paging: true,
            pageLength: 20,
            lengthChange: false,
            ordering: true,
            responsive: true,
            language: {
                url: 'https://cdn.datatables.net/plug-ins/2.2.2/i18n/it-IT.json'
            }
        });
    </script>
}
